{
  "name": "inference",
  "version": "0.1.0",
  "description": "Declarative model preparation and inference orchestration",
  "type": "module",
  "bin": {
    "infer": "dist/src/entrypoints/infer.js",
    "infer-cluster": "dist/src/entrypoints/cluster.js",
    "infer-instance": "dist/src/entrypoints/instance.js",
    "infer-prepare": "dist/src/entrypoints/prepare.js",
    "infer-remote": "dist/src/entrypoints/remote.js",
    "models": "dist/src/entrypoints/models.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=80 dist/tests/*.test.js",
    "test": "npm run build && node --test dist/tests/cli.test.js dist/tests/cluster-runtime.test.js dist/tests/contracts.test.js dist/tests/health-probe.test.js dist/tests/image-store.test.js dist/tests/instance-runtime.test.js dist/tests/local-lock.test.js dist/tests/model-store.test.js dist/tests/process-runner.test.js dist/tests/progress.test.js dist/tests/remote.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.106",
    "effect": "4.0.0-beta.106"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "license": "UNLICENSED"
}
