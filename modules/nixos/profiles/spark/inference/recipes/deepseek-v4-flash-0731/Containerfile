FROM ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

LABEL org.opencontainers.image.title="DeepSeek V4 Flash 0731 on two DGX Sparks"
LABEL org.opencontainers.image.version="0.1.1-0731"
LABEL org.opencontainers.image.source="https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark"

COPY prepare-runtime.py /usr/local/libexec/infer-deepseek-v4-prepare-runtime
COPY entrypoint.sh /usr/local/bin/infer-deepseek-v4-flash-0731
RUN chmod 0755 \
    /usr/local/libexec/infer-deepseek-v4-prepare-runtime \
    /usr/local/bin/infer-deepseek-v4-flash-0731

# Cap vLLM's shm busy-wait grace period so decode does not pin CPU cores
# with sched_yield() spinning (GB10 thermals; upstream default is 1s).
RUN f="$(python3 -c 'import vllm.distributed.device_communicators.shm_broadcast as m; print(m.__file__)')" \
  && grep -q 'busy_loop_s: float = 1,' "$f" \
  && sed -i 's/busy_loop_s: float = 1,/busy_loop_s: float = 0.002,/' "$f"

ENTRYPOINT ["/usr/local/bin/infer-deepseek-v4-flash-0731"]
