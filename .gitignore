# OS generated files
.DS_Store
Thumbs.db

# Editor/IDE specific files
.vscode/
.idea/
*.swp
*~

# Sensitive information
.env
*.key
*.pem
secrets.sh

# Clan stores encrypted machine Age identities in directories ending in .key.
!sops/secrets/*-age.key/
!sops/secrets/*-age.key/**

# Temporary files
*.log
*.tmp
ignore/

# Backup files
*.bak
*.backup

# AI
.claude/
.pi/

# Nix
.direnv/
result/
result
*.qcow2
*.raw

# OpenTofu (state itself IS committed - encrypted via the encryption block)
infra/**/.terraform/
*.tfstate.backup
