      "repeat": "node",
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"spark-node\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"spark-node\",node=~\"$node\"})",
          "legendFormat": "Used",
          "range": true,
          "refId": "A"
