{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Status: node & GPU exporters up, GPU collector succeeding, and both fabric links with carrier. Inference: any infer-*.service unit active or activating.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Degraded"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Healthy"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Inference"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "dark-gray",
                        "index": 0,
                        "text": "Idle"
                      },
                      "1": {
                        "color": "blue",
                        "index": 1,
                        "text": "Running"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "dark-gray",
                      "value": null
                    },
                    {
                      "color": "blue",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "maxPerRow": 4,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "repeat": "node",
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(min by (node) (up{cluster=\"spark\",job=~\"spark-(node|gpu)\",node=~\"$node\"}) * on (node) nvidia_smi_last_collect_success{job=\"spark-gpu\",node=~\"$node\"} * on (node) min by (node) (node_network_carrier{job=\"spark-node\",node=~\"$node\",device=~\"fabric[01]\"})) or on (node) (0 * up{job=\"spark-node\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Status",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "clamp_max(sum by (node) (node_systemd_unit_state{job=\"spark-node\",node=~\"$node\",name=~\"infer(-node)?-.*\\\\.service\",state=~\"active|activating\"}), 1) or on (node) (0 * up{job=\"spark-node\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Inference",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "$node",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Current CPU busy %, GPU SM utilization, unified memory usage, and root filesystem usage. CPU/GPU keep their series colors (high utilization is normal); Mem and Disk are threshold-colored capacity risks.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mem"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 95
                    },
                    {
                      "color": "red",
                      "value": 98
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 85
                    },
                    {
                      "color": "red",
                      "value": 95
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 8,
      "interval": "5s",
      "maxPerRow": 4,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "repeat": "node",
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "100 * (1 - avg by (node) (rate(node_cpu_seconds_total{job=\"spark-node\",node=~\"$node\",mode=\"idle\"}[$__rate_interval])))",
          "instant": true,
          "legendFormat": "CPU",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "100 * nvidia_smi_utilization_gpu_ratio{job=\"spark-gpu\",node=~\"$node\"}",
          "instant": true,
          "legendFormat": "GPU",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"spark-node\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"spark-node\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "Mem",
          "range": false,
          "refId": "C"
        },
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"spark-node\",node=~\"$node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"spark-node\",node=~\"$node\",mountpoint=\"/\"})",
          "instant": true,
          "legendFormat": "Disk",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Usage of the unified CPU+GPU memory pool (1 - MemAvailable / MemTotal).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
